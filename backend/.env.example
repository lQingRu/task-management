PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_assignment
# Configure at least one provider key. Leave unused providers blank.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_MS=5000
LLM_MAX_ATTEMPTS=2
LLM_DEFAULT_RETRY_DELAY_MS=250
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# The inline value takes precedence over the file. Include {{AVAILABLE_SKILLS}}.
# SKILL_INFERENCE_SYSTEM_PROMPT=Custom prompt with {{AVAILABLE_SKILLS}}
SKILL_INFERENCE_SYSTEM_PROMPT_FILE=config/skill-inference-system-prompt.txt
